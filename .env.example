# Flask / identity
FLASK_SECRET_KEY=replace-me
ENVIRONMENT=development
APP_BASE_URL=http://localhost:5050
PROJECT_ID=your-google-cloud-project
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_LOCATION=global
FIREBASE_STORAGE_BUCKET=your-private-bucket
FIREBASE_WEB_CONFIG={}

# Chat jobs: inline for local development, cloud for Cloud Run
TASKS_MODE=inline
TASKS_PROJECT_ID=your-google-cloud-project
TASKS_LOCATION=us-central1
TASKS_QUEUE=caseclosed-jobs
TASKS_WORKER_URL=https://YOUR_SERVICE/internal/jobs/run
TASKS_WORKER_AUDIENCE=https://YOUR_SERVICE
TASKS_SERVICE_ACCOUNT=caseclosed-tasks@YOUR_PROJECT.iam.gserviceaccount.com
# Optional fallback for emulators; production should use verified OIDC.
INTERNAL_WORKER_TOKEN=
JOB_MAX_ATTEMPTS=3

# Retrieval
VECTOR_SEARCH_ENABLED=false
VECTOR_SEARCH_PROJECT_ID=your-google-cloud-project
VECTOR_SEARCH_LOCATION=us-central1
VECTOR_PRIVATE_COLLECTION=caseclosed-matters
VECTOR_LEGAL_COLLECTION=caseclosed-law
VECTOR_SEARCH_FIELD=text_embedding
VECTOR_EMBEDDING_MODEL=gemini-embedding-001
VECTOR_EMBEDDING_DIMENSIONS=3072
RETRIEVAL_TOP_K=8

# OCR
DOCUMENT_AI_PROCESSOR_ID=
DOCUMENT_AI_LOCATION=us

# Official legal-source feeds. Each adapter declares JSON record paths/fields.
LEGAL_CORPUS_SYNC_TOKEN=replace-with-a-random-secret
LEGAL_CORPUS_SYNC_SERVICE_ACCOUNT=caseclosed-scheduler@YOUR_PROJECT.iam.gserviceaccount.com
LEGAL_CORPUS_SYNC_AUDIENCE=https://YOUR_SERVICE
LEGAL_CORPUS_DAILY_LIMIT=500
LEGAL_SOURCE_REGISTRY=[]

# Tiered GA Gemini models. Keep Gemini traffic on its own supported endpoint.
CHAT_FAST_MODEL=gemini-3.5-flash-lite
CHAT_REASONING_MODEL=gemini-3.6-flash
